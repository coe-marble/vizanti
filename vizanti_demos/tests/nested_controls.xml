<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4" main_tree_to_execute="Mission">
  <BehaviorTree ID="Mission">
    <Fallback name="mission_selector">
      <Sequence name="normal_operation">
        <IsBatteryOk minimum_charge="{minimum_charge}"/>
        <RetryUntilSuccessful num_attempts="3">
          <NavigateToPose goal="{goal}"/>
        </RetryUntilSuccessful>
      </Sequence>
      <ForceSuccess>
        <ReturnToDock docking_station="{home_dock}"/>
      </ForceSuccess>
    </Fallback>
  </BehaviorTree>
</root>